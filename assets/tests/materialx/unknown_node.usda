#usda 1.0

def Material "Mat"
{
    token outputs:mtlx:surface.connect = </Mat/Surface.outputs:out>

    def Shader "Surface"
    {
        uniform token info:id = "ND_standard_surface_surfaceshader"
        color3f inputs:base_color.connect = </Mat/Unknown.outputs:out>
        token outputs:out
    }

    def Shader "Unknown"
    {
        uniform token info:id = "ND_hameron_magic_color3"
        color3f outputs:out
    }
}
